# Server-only secrets (never prefix with VITE_). Generate with:
#   node scripts/hash-passphrase.mjs "your secret words"
SITE_PASSPHRASE_HASH=
SESSION_SECRET=
# Vercel Blob (private store). Set automatically when the store is connected.
BLOB_READ_WRITE_TOKEN=
# Local development only:
# PRIVATE_STORAGE=local
# PRIVATE_DIR=.private/site
# COOKIE_SECURE=false
